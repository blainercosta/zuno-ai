# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional overrides
VITE_SUPPORT_WHATSAPP=5511918492120

# AbacatePay (Supabase Edge Functions secrets, not read by the frontend — see
# docs/ABACATEPAY_WEBHOOK.md)
# ABACATEPAY_API_KEY=abc_...
# ABACATEPAY_PRODUCT_ID=prod_SUnKE04rDRpXQADSaUajkYEm
# ABACATEPAY_METHODS=PIX
# ABACATEPAY_WEBHOOK_SECRET=...

# Phantombuster (Supabase Edge Function secrets — see docs/PHANTOMBUSTER_INGESTION.md)
# PHANTOMBUSTER_API_KEY=...            Phantombuster > Settings > API key
# PHANTOMBUSTER_AGENT_ID=...           id of the "LinkedIn Job Scraper" Phantom
# PHANTOMBUSTER_WEBHOOK_SECRET=...     random string; goes in ?secret= of webhook + spreadsheet URL
# PHANTOMBUSTER_AUTO_APPROVE=true      false = every scraped job lands as pending
# PHANTOMBUSTER_MAX_AGE_DAYS=45        skip listings older than this
# Vercel relay (/api/phantombuster/*) additionally needs SUPABASE_URL + SUPABASE_ANON_KEY
