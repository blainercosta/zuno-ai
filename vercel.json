{
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "usezuno.app"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://www.usezuno.app/$1"
      }
    },
    {
      "src": "/sitemap-news.xml",
      "dest": "/api/sitemap?type=news"
    },
    {
      "src": "/sitemap-jobs.xml",
      "dest": "/api/sitemap?type=jobs"
    },
    {
      "src": "/sitemap-professions.xml",
      "dest": "/api/sitemap?type=professions"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|json|webp|avif|xml|txt|webmanifest))",
      "dest": "/$1"
    },
    {
      "src": "/noticias-ia/(.+)",
      "dest": "/api/og-news?slug=$1",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Googlebot|bingbot).*"
        }
      ]
    },
    {
      "src": "/job/(.+)",
      "dest": "/api/og-job?slug=$1",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Googlebot|bingbot).*"
        }
      ]
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/og-news.ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/og-job.ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/kubo-ingest.ts": {
      "memory": 512,
      "maxDuration": 10
    }
  }
}
